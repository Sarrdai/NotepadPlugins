<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TiffPlusPlus</AssemblyName>
    <RootNamespace>TiffPlusPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Notepad++ loads native exports, so a concrete platform is required (no AnyCPU). -->
    <Platforms>x64;x86</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>TiffPlusPlus</Product>
    <Description>Notepad++ plugin: shows the embedded XML of TIFF files and an optional image viewer panel.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WebView2 parts are embedded into the plugin dll (see EmbeddedDependencies.cs), nothing is copied. -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="UnmanagedExports.Repack.Upgrade" Version="1.2.1">
      <!-- The export rewriting task needs full-framework MSBuild (Windows). On 'dotnet build' only compile. -->
      <ExcludeAssets Condition="'$(MSBuildRuntimeType)' == 'Core'">build</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Viewer\viewer.html" LogicalName="TiffPlusPlus.Viewer.viewer.html" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="TiffPlusPlus.Embedded.Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="TiffPlusPlus.Embedded.Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-$(Platform)\native\WebView2Loader.dll" LogicalName="TiffPlusPlus.Embedded.WebView2Loader.dll" />
  </ItemGroup>

</Project>
