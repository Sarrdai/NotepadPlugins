// JSON++ - Notepad++ plugin
// SPDX-License-Identifier: GPL-3.0-or-later

#include <winver.h>

#define JPP_VERSION 1,0,0,0
#define JPP_VERSION_STR "1.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION JPP_VERSION
 PRODUCTVERSION JPP_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JSON++ contributors"
            VALUE "FileDescription", "JSON++ - synchronised pretty view for compact JSON (Notepad++ plugin)"
            VALUE "FileVersion", JPP_VERSION_STR
            VALUE "InternalName", "JsonPlusPlus"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "JsonPlusPlus.dll"
            VALUE "ProductName", "JSON++"
            VALUE "ProductVersion", JPP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
